{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "es2022"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    // Deno sources: they import jsr:/npm: specifiers and reference the Deno
    // global, none of which resolve under Next's TypeScript config. They are
    // deployed to Supabase, never bundled here, and are typechecked by the
    // Supabase CLI on deploy. shared-client/ is deliberately NOT excluded — it
    // is ordinary Next-compatible code and we want its errors surfaced here.
    "shared-edge-functions"
  ]
}
